{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        ring/ring-core {:mvn/version "1.12.1"}
        ring/ring-jetty-adapter {:mvn/version "1.12.1"}
        metosin/reitit {:mvn/version "0.7.1"}
        metosin/muuntaja {:mvn/version "0.6.10"}
        com.cognitect.aws/api {:mvn/version "0.8.741"}
        com.cognitect.aws/endpoints {:mvn/version "871.2.53.2"}
        com.cognitect.aws/dynamodb {:mvn/version "871.2.51.4"}
        org.apache.kafka/kafka-clients {:mvn/version "4.2.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        clj-commons/iapetos {:mvn/version "0.1.15"}}
 :aliases
 {:run {:main-opts ["-m" "ledger.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ring/ring-mock {:mvn/version "0.6.2"}}
         :main-opts ["-m" "cognitect.test-runner" "-e" "integration"]}
  :test-integration {:extra-paths ["test"]
                      :extra-deps {io.github.cognitect-labs/test-runner
                                   {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                                   ring/ring-mock {:mvn/version "0.6.2"}}
                      :main-opts ["-m" "cognitect.test-runner" "-i" "integration"]}}}
